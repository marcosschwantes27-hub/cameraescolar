# Banco de dados (Supabase)
# No painel Supabase: Connect > escolha a string adequada ao seu ambiente.
# Troque o prefixo "postgresql://" por "postgresql+psycopg://" e preserve
# "?sslmode=require". Nunca versione a URL real nem a senha.
REGISTRO_DATABASE_URL=postgresql+psycopg://USUARIO:URL_DA_SENHA@HOST_SUPABASE:5432/postgres?sslmode=require

# FastAPI (segredos: somente no ambiente de execução)
REGISTRO_ENVIRONMENT=development
REGISTRO_JWT_SECRET=gere-uma-chave-aleatoria-com-pelo-menos-32-caracteres
REGISTRO_ACCESS_TOKEN_EXPIRE_MINUTES=30
REGISTRO_CORS_ALLOWED_ORIGINS=["http://127.0.0.1:4173","http://localhost:4173"]
REGISTRO_AUTH_REQUIRED=false
REGISTRO_DEMO_SCHOOL_CODE=DEMO
REGISTRO_BOOTSTRAP_LOCAL_SCHOOL=true
REGISTRO_FACE_MATCH_THRESHOLD=0.45
REGISTRO_FACE_MATCH_MARGIN=0.06
REGISTRO_FACE_DUPLICATE_FRAME_THRESHOLD=0.55
REGISTRO_FACE_DUPLICATE_MEDIAN_THRESHOLD=0.60
REGISTRO_FACE_DUPLICATE_REQUIRED_RATIO=0.70

# Frontend (valor público; use a URL HTTPS da API publicada quando aplicável)
VITE_API_BASE_URL=http://127.0.0.1:8000
